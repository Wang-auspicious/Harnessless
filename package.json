{
  "name": "forgeops",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "description": "ForgeOps — Enterprise Software Engineering Meta-Harness & Multi-Repo Control Plane",
  "main": "dist/electron/main.cjs",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "start": "node scripts/start.mjs",
    "lint": "eslint --no-error-on-unmatched-pattern src renderer verify scripts",
    "fix": "eslint --fix --no-error-on-unmatched-pattern src renderer verify scripts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "verify:gates": "node --experimental-strip-types --test --test-concurrency=1 \"verify/**/*.verify.ts\"",
    "verify": "npm run lint && npm run typecheck && npm run build && npm run verify:gates"
  },
  "dependencies": {
    "@xyflow/react": "^12.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.5.1",
    "esbuild": "^0.27.0",
    "gts": "^7.0.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.4"
  }
}
